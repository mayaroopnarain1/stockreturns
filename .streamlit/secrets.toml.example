# Copy this file to `.streamlit/secrets.toml` and fill in the values below.
# `.streamlit/secrets.toml` is gitignored — it must never be committed.

[edgar]
# SEC requires every request to data.sec.gov to carry a contact email in the
# User-Agent header per the fair-access policy:
#   https://www.sec.gov/developer
# Replace the placeholder with a real mailbox you control. Requests missing a
# real contact may be throttled or blocked.
user_agent = "StockLens/1.0 your-email@example.com"

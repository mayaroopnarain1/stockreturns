# Optional configuration. The app runs out of the box without this file —
# it identifies itself to SEC using the repo URL as the User-Agent and falls
# back to yfinance whenever SEC throttles a request.
#
# Only copy this to `.streamlit/secrets.toml` and fill it in if:
#   * you plan to hit EDGAR heavily (e.g. bulk screener runs), OR
#   * you want to supply a real contact email per SEC's fair-access guidance
#     (https://www.sec.gov/developer).
#
# `.streamlit/secrets.toml` is gitignored — never commit the filled-in file.

[edgar]
# Replace with a real mailbox you control, or delete the line to use the
# repo-URL default. Requests with a real contact are throttled less often.
user_agent = "StockLens/1.0 your-email@example.com"
